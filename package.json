{
  "name": "game-cat",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "A local, read-first view of a Steam library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fran2889/game-cat.git"
  },
  "homepage": "https://github.com/fran2889/game-cat",
  "bugs": {
    "url": "https://github.com/fran2889/game-cat/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "game-cat": "dist/server/cli.js"
  },
  "main": "./dist/server/index.js",
  "exports": {
    ".": "./dist/server/index.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "start": "node dist/server/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "npm run build && playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "test:perf": "npm run build && tsx scripts/perf/run.ts",
    "perf:fixtures": "tsx scripts/perf/print-fixtures.ts",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:links": "remark --frail --quiet .",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint:md && npm run lint:links && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "@mantine/core": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@tanstack/react-query": "5.107.1",
    "better-sqlite3": "13.2.0",
    "commander": "15.1.0",
    "fastify": "5.12.8",
    "kysely": "0.29.9",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "^8.20.0",
    "eslint": "10.15.0",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1",
    "remark-cli": "12.0.1",
    "remark-validate-links": "13.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
